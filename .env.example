# Copy to .env (gitignored) and fill in real values.
# Keys from https://app.alpaca.markets → API Keys (paper keys — free account).

ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-secret-here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Dead-man's switch (optional but strongly recommended). Create a check at
# https://healthchecks.io (free tier) and paste its ping URL here. Vega pings
# /start when a run begins and the base URL when it completes, so a run that
# begins and never finishes — a wedge — alerts you off-machine. Unset means
# NOTHING external is watching the pipeline.
VEGA_HEALTHCHECK_URL=

# SEC EDGAR (WI-226 filing evidence). SEC requires a declared, contactable
# User-Agent and blocks generic ones; there is deliberately no default, so an
# unset value fails loudly instead of getting the project rate-limited.
VEGA_SEC_USER_AGENT="Vega research <your-email@example.com>"
